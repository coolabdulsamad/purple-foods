# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (HMAC pepper for OTP codes, signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # Postgres connection string (postgresql://user:pass@host/db?sslmode=require) — Neon
# Pins OUR database when the host platform injects its own DATABASE_URL
# (process env beats .env). The app prefers PF_DATABASE_URL when set.
PF_DATABASE_URL=          # same value as DATABASE_URL

# ── SMS (OTP delivery) ─────────────────────────────────────────
# Optional. Without a key, requestOtp returns the code inline as devCode.
TERMII_API_KEY=           # Termii API key (https://termii.com)
TERMII_SENDER_ID=         # Sender ID, e.g. PurpleFds (defaults to PurpleFds)

# ── Google sign-in ────────────────────────────────────────────
# Optional. Create an OAuth Client ID (Web) in Google Cloud Console.
# GOOGLE_CLIENT_ID is checked server-side; VITE_ variant renders the button.
GOOGLE_CLIENT_ID=         # e.g. 123456789-abc.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=    # same value, exposed to the frontend

# ── Maps ───────────────────────────────────────────────────────
# Optional. Without a key, all maps (zone picker + live order tracking)
# use OpenStreetMap tiles and the browser's geolocation — fully working,
# no key needed. Set this to switch every map to Google Maps tiles.
VITE_GOOGLE_MAPS_API_KEY= # Google Maps API key (frontend-visible)
