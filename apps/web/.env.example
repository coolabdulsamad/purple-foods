# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (HMAC pepper for OTP codes, signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # Postgres connection string (postgresql://user:pass@host/db?sslmode=require) — Neon

# ── SMS (OTP delivery) ─────────────────────────────────────────
# Optional. Without a key, requestOtp returns the code inline as devCode.
TERMII_API_KEY=           # Termii API key (https://termii.com)
TERMII_SENDER_ID=         # Sender ID, e.g. PurpleFds (defaults to PurpleFds)
